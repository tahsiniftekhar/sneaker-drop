PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://user:password@localhost:5432/sneaker-drop
# Set to true for databases that require TLS (e.g. Neon). Leave unset/false for a
# plain Postgres on a private network (e.g. a private Docker network).
DB_SSL=false
# How long a reservation holds a unit, in seconds.
RESERVATION_TTL_SECONDS=60
# How often expired reservations are released, in milliseconds.
EXPIRY_SWEEP_INTERVAL_MS=5000
# Database connection pool size.
DB_POOL_MAX=5
